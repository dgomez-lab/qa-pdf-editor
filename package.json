{
  "name": "qa-pdf-editor",
  "version": "1.0.0",
  "private": true,
  "description": "E2E PDF editor — Playwright (migración desde qai-pa-pdf-editor / Selenium+Cucumber)",
  "scripts": {
    "bddgen": "bddgen",
    "test": "npm run bddgen && playwright test",
    "test:grep": "npm run bddgen && playwright test --grep",
    "test:tag": "npm run bddgen && playwright test --grep",
    "test:pdfhint-smoke": "QAI_PA_CONFIGURATION_PATH=config/configuration.pdfhint.json npm run bddgen && QAI_PA_CONFIGURATION_PATH=config/configuration.pdfhint.json playwright test --grep @PDFEDITOR_PDFHINT_SMOKE",
    "test:pdfhint-tag": "QAI_PA_CONFIGURATION_PATH=config/configuration.pdfhint.json npm run test:tag --",
    "test:ci-fast": "npm run bddgen && playwright test --grep \"@PDFEDITOR_SEO|@PDFEDITOR_PDFHINT_SMOKE_SEO\"",
    "test:ci-full": "npm run bddgen && playwright test --grep-invert @MANUAL_SCREEN_CAPTURE",
    "test:ci-regression-functional": "playwright test --grep-invert @MANUAL_SCREEN_CAPTURE",
    "test:ci-regression": "npm run bddgen && npm run test:ci-regression-functional && PLAYWRIGHT_VISUAL_SNAPSHOTS=1 playwright test --grep @PDFEDITOR_VISUAL",
    "test:ci-visual": "npm run bddgen && PLAYWRIGHT_VISUAL_SNAPSHOTS=1 playwright test --grep @PDFEDITOR_VISUAL",
    "test:ui": "npm run bddgen && playwright test --ui",
    "test:report": "npx http-server ./cucumber-report -c-1 -a localhost -o index.html",
    "test:cucumber-report": "npm run test:report",
    "porting:stats": "node scripts/porting-parity-stats.mjs",
    "porting:tags": "node scripts/porting-tags.mjs",
    "sync:legacy-elements": "node scripts/sync-legacy-elements.mjs",
    "setup:github-actions": "python3 scripts/setup-github-actions-env.py",
    "typecheck": "tsc --noEmit",
    "test:unit": "playwright test --config=playwright.unit.config.ts",
    "test:unit:crm-grid": "npm run test:unit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@cucumber/messages": "^27.2.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.3",
    "playwright-bdd": "^8.5.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
