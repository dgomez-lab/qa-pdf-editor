# Secretos y flags que no van en config/configuration.json (gitignored; copia a `.env`).
# En GitHub Actions, configura los equivalentes en Settings → Secrets and variables → Actions.

# --- Secrets (Actions → Secrets); sync with: GH_TOKEN=ghp_... npm run setup:github-actions ---
QAI_TOKEN_PARAM=
PLAYWRIGHT_CRM_USER=
PLAYWRIGHT_CRM_PASSWORD=
PLAYWRIGHT_MAILPIT_USER=
PLAYWRIGHT_MAILPIT_PASSWORD=
PLAYWRIGHT_QA_API_KEY=

# --- Variables opcionales (Actions → Variables) ---
# PLAYWRIGHT_BASE_URL=
# PLAYWRIGHT_APP=mergedpdf
# PLAYWRIGHT_MVPS_SLOT=
# PLAYWRIGHT_PDFHINT_BASE_URL=
# PLAYWRIGHT_PDFHINT_APP_BASE_URL=
# SEO_LOGIN_PATHNAME=/login

# --- Flags locales / CI (full y regression los fijan en el workflow) ---
PLAYWRIGHT_PAYMENT_SMOKE=
PLAYWRIGHT_DEFAULT_TEST_IP=ES
PLAYWRIGHT_TRANSACTIONAL_PAYMENT_CONFIRMATION=
PLAYWRIGHT_PDFHINT_DASHBOARD_SMOKE=

# NO pongas aquí HEADLESS, APP, ENVIRONMENT, BASE_URL ni SLOWMO — solo en configuration.json.
