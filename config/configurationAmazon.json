{
  "driver": {
    "type": "selenium",
    "server": "amazon",
    "browser": "chrome",
    "headless": true,
    "driverNativeLogs": false,
    "pathDownloads": "/home/seluser/Downloads"
  },
  "logLevel": "DEBUG",
  "showConfigs": true,
  "timeouts": {
    "cucumberPromisesTimeout": 200,
    "waiter": 60,
    "qualityWaiter": 45,
    "scrollWaiter": 0.15,
    "selectWaiter": 0.3,
    "stepWaiter": 0.5
  }
}